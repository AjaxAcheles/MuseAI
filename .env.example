# Copy to .env and fill in. The Anthropic SDK reads ANTHROPIC_API_KEY automatically.
ANTHROPIC_API_KEY=sk-ant-...

# --- Provider selection ----------------------------------------------------
# Each stage group picks a provider: "anthropic" (Claude) or "local"
# (any OpenAI-compatible server). Defaults to anthropic.
MUSEAI_PLANNING_PROVIDER=anthropic
MUSEAI_DRAFTING_PROVIDER=anthropic
MUSEAI_PLANNING_MODEL=claude-opus-4-8
MUSEAI_DRAFTING_MODEL=claude-opus-4-8

# --- Local (OpenAI-compatible) server --------------------------------------
# Default targets Ollama. Works with LM Studio, vLLM, llama.cpp --server, etc.
MUSEAI_LOCAL_BASE_URL=http://localhost:11434/v1
MUSEAI_LOCAL_API_KEY=ollama

# Example A — fully local (no Claude / no ANTHROPIC_API_KEY needed):
#   MUSEAI_PLANNING_PROVIDER=local
#   MUSEAI_DRAFTING_PROVIDER=local
#   MUSEAI_PLANNING_MODEL=llama3.1
#   MUSEAI_DRAFTING_MODEL=llama3.1
#
# Example B — Claude plans, local model drafts the prose:
#   MUSEAI_PLANNING_PROVIDER=anthropic
#   MUSEAI_DRAFTING_PROVIDER=local
#   MUSEAI_PLANNING_MODEL=claude-opus-4-8
#   MUSEAI_DRAFTING_MODEL=llama3.1

# --- App -------------------------------------------------------------------
MUSEAI_DB_PATH=museai.db
MUSEAI_HOST=localhost
MUSEAI_PORT=8000
